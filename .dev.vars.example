# Copy to .dev.vars for `wrangler dev`. Do not commit .dev.vars.
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=123456789
# The bearer token of GET /status. Remove this line to turn the route off.
STATUS_TOKEN=replace-with-a-long-random-value
# Optional. With no value, the Worker sends no heartbeat to dms.
DMS_PING_TOKEN=replace-with-the-dms-ping-token
